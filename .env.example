# MarketPilot: leave broker secrets empty for replay. Never commit .env.local.
# Production requires a strong password; username is pilot. Use HTTPS outside localhost.
MARKETPILOT_PASSWORD=""
MARKETPILOT_DATA_DIR=".marketpilot"
# Use the same durable directory for the web process and worker; never reset active lockouts.
# LIVE attempts are audited even while unconfigured. This is not proof of connectivity.
ANGEL_API_KEY=""
# Authorized SmartAPI JWT obtained outside this app; renew when the session expires.
ANGEL_ACCESS_TOKEN=""
ANGEL_CLIENT_LOCAL_IP=""
ANGEL_CLIENT_PUBLIC_IP=""
ANGEL_MAC_ADDRESS=""
# Local reviewed specs file matching the current broker master. See MARKETPILOT.md.
MARKETPILOT_SPECS_FILE=""
# Optional licensed JSON adapter endpoints; never use unlicensed scraped market data.
WTI_CONTEXT_URL=""
BRENT_CONTEXT_URL=""
OIL_NEWS_URL=""
CONTEXT_API_KEY=""
# No trader-positioning provider is bundled. Missing global sources remain UNAVAILABLE.
# Read FORWARD_SESSION.md before a LIVE session. Real-account smoke test: NOT VERIFIED.
