{
  "name": "marketpilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "marketpilot:worker": "tsx --env-file-if-exists=.env.local scripts/marketpilot-worker.ts",
    "marketpilot:replay": "node scripts/generate-marketpilot-replay.mjs",
    "test:marketpilot": "vitest run tests/marketpilot.test.ts",
    "test:marketpilot:e2e": "playwright test --config=playwright.marketpilot.config.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test --config=playwright.marketpilot.config.ts",
    "verify": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "lucide-react": "^1.35.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module"
}
