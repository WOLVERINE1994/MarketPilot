# MarketPilot: leave broker secrets empty for replay. Never commit .env.local.
# Production requires a strong password; username is pilot. Use HTTPS outside localhost.
MARKETPILOT_PASSWORD=""
MARKETPILOT_DATA_DIR=".marketpilot"
# Use the same durable directory for the web process and worker; never reset active lockouts.
# LIVE attempts are audited even while unconfigured. This is not proof of connectivity.
ANGEL_API_KEY=""
ANGEL_CLIENT_CODE=""
# Authorized SmartAPI JWT obtained outside this app; renew when the session expires.
ANGEL_ACCESS_TOKEN=""
# SmartAPI WebSocket V2 authentication token, saved silently by the local login helper.
ANGEL_FEED_TOKEN=""
ANGEL_CLIENT_LOCAL_IP=""
ANGEL_CLIENT_PUBLIC_IP=""
ANGEL_MAC_ADDRESS=""
# Local reviewed specs file matching the current broker master. See MARKETPILOT.md.
MARKETPILOT_SPECS_FILE=""
# Reviewed Mini CE/PE monetary specs and exact option-expiry/underlying mapping.
MARKETPILOT_OPTION_SPECS_FILE=""
# Reviewed date-specific MCX trading sessions/holidays; missing dates block entries.
MARKETPILOT_SESSION_FILE=""
# Twelve Data provides timestamped WTI/Brent spot context; cached for one minute.
# Alternatively, OilPriceAPI's Core Commodity batch is cached for five minutes.
# Set only the provider key you intend to use.
TWELVE_DATA_API_KEY=""
# The signal context gate still marks source observations older than 15 minutes stale.
OILPRICEAPI_KEY=""
# Built-in OilPrice.com public RSS news feed; optional licensed endpoint override and Bearer key.
WTI_CONTEXT_URL=""
BRENT_CONTEXT_URL=""
OIL_NEWS_URL=""
CONTEXT_API_KEY=""
# Optional MarketPilot chat uses the server-side OpenAI Responses API.
# The key is never sent to the browser; configure it only in local .env.local.
OPENAI_API_KEY=""
MARKETPILOT_AI_MODEL="gpt-6-astra"
# No trader-positioning provider is bundled. Missing global sources remain UNAVAILABLE.
# Read FORWARD_SESSION.md before a LIVE session. Real-account smoke test: NOT VERIFIED.
