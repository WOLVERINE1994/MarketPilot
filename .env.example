# Copy this file to .env and fill in your own values. Never share .env or commit it.

# ---- Angel One SmartAPI (https://smartapi.angelone.in) ----
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
# Your Angel One login PIN
ANGEL_PIN=
# Optional: the TOTP secret shown when you enabled TOTP for SmartAPI.
# If set, the app logs in by itself every day. If empty, it asks for the 6-digit code when it starts.
ANGEL_TOTP_SECRET=
# Optional identity headers (defaults are detected automatically)
ANGEL_CLIENT_LOCAL_IP=
ANGEL_CLIENT_PUBLIC_IP=
ANGEL_MAC_ADDRESS=

# ---- Your money and risk (rupees) ----
CAPITAL=31000
# Warn when a trade's estimated loss at stop-loss is above this
MAX_LOSS_PER_TRADE=620
# Warn (and say "stop for today") after this much loss in a day
DAILY_LOSS_LIMIT=1500
MAX_TRADES_PER_DAY=4
# Estimated brokerage + taxes for one round trip (buy + sell)
COST_PER_TRADE=60

# ---- Strategy ----
# Candle size in minutes for signals
TIMEFRAME=5
EMA_FAST=9
EMA_SLOW=21
EMA_TREND=50
RSI_LENGTH=14
ATR_LENGTH=14
# Stop-loss distance = ATR_STOP x ATR. Target = RISK_REWARD x stop distance.
ATR_STOP=1.5
RISK_REWARD=2
# Move stop to entry after price moves this many R in your favour (0 = off)
BREAKEVEN_AT_R=1
# How to trade crude signals: OPTIONS (buy CE/PE) or FUTURES (Crude Oil Mini futures, ~₹28k margin).
# Silver Mini signals are always CE/PE.
CRUDE_TRADE=OPTIONS
# Option strike: ATM, ITM1 or OTM1
OPTION_STRIKE=ATM
# IST times (24h). No new entries outside the window. Open trades are squared off at SQUARE_OFF.
ENTRY_START=09:15
ENTRY_END=22:45
SQUARE_OFF=23:15

# ---- Which instruments to watch: comma list of CRUDEOILM, SILVERM ----
PRODUCTS=CRUDEOILM,SILVERM

# ---- Phone alerts through Telegram (optional, recommended) ----
# Create a bot with @BotFather, send it a message, then get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Dashboard ----
PORT=3100
# 127.0.0.1 = only this computer. Use 0.0.0.0 to open it from your phone on the same Wi-Fi (set a password!)
HOST=127.0.0.1
DASHBOARD_PASSWORD=
